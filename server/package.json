{
  "name": "brixwall-server",
  "version": "1.0.0",
  "description": "Brixwall API: turns your running containers into a live brick wall",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "author": "Manish",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
